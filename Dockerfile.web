# 프론트엔드 — React(Vite) 빌드 결과를 nginx 로 서빙
#
# VITE_* 값은 런타임이 아니라 빌드 시점에 번들에 박힌다. 그래서 카카오맵 키는
# --build-arg 로 넘겨야 하고, 값을 바꾸면 반드시 다시 빌드해야 한다.

FROM node:20-slim AS build

WORKDIR /web

# package*.json 만 먼저 복사해 npm ci 레이어를 캐시한다.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

ARG VITE_KAKAO_MAP_KEY=""
ARG VITE_API_BASE=/api
ARG VITE_USE_MOCK=false
ENV VITE_KAKAO_MAP_KEY=$VITE_KAKAO_MAP_KEY \
    VITE_API_BASE=$VITE_API_BASE \
    VITE_USE_MOCK=$VITE_USE_MOCK

RUN npm run build


FROM nginx:1.27-alpine

# /api 프록시와 SPA 라우팅 설정. 개발 중 vite.config.js 가 하던 일을 대신한다.
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --spider -q http://127.0.0.1/ || exit 1
