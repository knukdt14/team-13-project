# docker compose 가 읽는 환경변수. 이 파일을 .env 로 복사해 값을 채운다.
#
#   cp .env.example .env
#
# .env 는 커밋하지 않는다(.gitignore 처리됨).
#
# ⚠ 로컬 실행과 컨테이너는 키를 읽는 곳이 다르다.
#
#            로컬 실행            docker compose
#   Solar    src/rag/.env         이 파일
#   카카오맵  frontend/.env        이 파일
#
# 컨테이너에는 src/rag/.env 도 frontend/.env 도 들어가지 않는다
# (.dockerignore 가 **/.env 를 막는다). compose 는 이 파일만 읽는다.
# 여기를 비워 두면 로컬에서는 되는데 컨테이너에서만 챗봇이나 지도가 죽는다.

# ---------------------------------------------------------------- AI 서비스
# Upstage 콘솔에서 발급. 없으면 검색은 되지만 답변 생성이 503 이 된다.
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-pro3

# 임베딩 모델. 인덱스를 만든 모델과 반드시 같아야 한다(manifest.json 과 대조함).
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=4

# ---------------------------------------------------------------- 프론트엔드
# 카카오 개발자 콘솔의 JavaScript 키. 사용 도메인 등록이 필요하다.
# 빌드 시점에 번들로 들어가므로, 값을 바꾸면 web 이미지를 다시 빌드해야 한다.
VITE_KAKAO_MAP_KEY=
