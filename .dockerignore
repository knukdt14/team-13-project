# 이미지에 들어가면 안 되거나, 들어갈 필요가 없는 것들.
# COPY 는 .gitignore 를 보지 않으므로 여기에 따로 적어야 한다.

.git
.github
.venv
venv
__pycache__
**/__pycache__
**/*.py[cod]

# API 키가 이미지에 구워지는 사고를 막는다. compose 의 environment 로 넘긴다.
**/.env
!**/.env.example

# 로컬 산출물
app.db
*.db
chroma_db/
frontend/node_modules
frontend/dist

# 런타임에 쓰지 않는 대용량 원본 (수집·인덱싱 때만 필요)
#
# policies_rag_docs.json 은 src/rag/cli/build_index.py 만 읽는다. 인덱스는
# 이미 만들어져 src/rag/storage/ 에 들어가므로 컨테이너에는 필요 없다.
# 인덱스를 컨테이너 안에서 만들려면 이 줄을 지워야 한다.
data/youth_policies_raw.json
data/policies_rag_docs.json
data/*.pdf
data/*.xlsx
data/zipcode_db/
data/zipcode_DB.zip

# 문서·개발용
docs/
tests/
src/rag/tests/
*.md
!README.md
